<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_10dp">


        <ImageView
            android:id="@+id/imageViewProduct"
            android:layout_width="@dimen/width_100dp"
            android:layout_height="@dimen/height_100dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_placeholder"
            android:background="@android:color/white"
            android:padding="@dimen/padding_8dp" />


        <LinearLayout
            android:layout_width="@dimen/width_0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_start_12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Product Title"
                android:fontFamily="@font/raleway_medium"
                android:textColor="@color/text_color_2a2a2a"
                android:textSize="@dimen/text_size_16sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textViewPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="$29.99"
                android:fontFamily="@font/raleway_bold"
                android:textColor="@color/text_color_0ca8b9"
                android:textSize="@dimen/text_size_14sp"
                android:layout_marginTop="@dimen/margin_top_4dp" />

            <TextView
                android:id="@+id/textViewRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="★ 4.7 (83)"
                android:textColor="@color/text_color_e4a719"
                android:textSize="@dimen/text_size_13sp"
                android:fontFamily="@font/raleway_bold"
                android:layout_marginTop="@dimen/margin_top_2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
