<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_f2f2f2">

    <data>
        <variable
            name="viewModel"
            type="com.akakce.case_study.ui.viewmodel.ProductDetailViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ScrollView
            android:visibility="visible"
            android:id="@+id/contentScrollView"
            android:layout_width="match_parent"
            android:background="@color/background_f2f2f2"
            android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_10dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_350dp"
                        android:layout_margin="@dimen/margin_8dp"
                        android:elevation="@dimen/elevation_6dp"
                        app:cardCornerRadius="@dimen/radius_12dp">


                        <ImageView
                            android:id="@+id/imageViewProduct"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/textViewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color_2a2a2a"
                        android:textSize="@dimen/text_size_18sp"
                        android:fontFamily="@font/raleway_medium"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/margin_bottom_8dp"
                        tools:text="Product Title" />

                    <TextView
                        android:id="@+id/textViewPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_bottom_8dp"
                        android:fontFamily="@font/raleway_regular"
                        android:textColor="@color/text_color_0ca8b9"
                        android:textSize="@dimen/text_size_16sp"
                        android:textStyle="bold"
                        tools:text="$29.99" />

                    <TextView
                        android:id="@+id/textViewCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color_202020"

                        android:textSize="@dimen/text_size_14sp"
                        android:fontFamily="@font/raleway_regular"
                        android:layout_marginBottom="@dimen/margin_bottom_16dp"
                        tools:text="Category: Electronics" />


                    <TextView
                        android:id="@+id/textViewDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/raleway_regular"
                        android:textColor="@color/text_color_202020"
                        android:textSize="@dimen/text_size_14sp"
                        android:layout_marginBottom="@dimen/margin_bottom_16dp"
                        tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit." />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/margin_bottom_16dp">

                        <RatingBar
                            android:id="@+id/ratingBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:numStars="5"
                            android:stepSize="0.5"
                            android:isIndicator="true"
                            android:rating="4.5"
                            style="@style/Widget.AppCompat.RatingBar.Small"
                            android:layout_marginEnd="@dimen/margin_end_8dp"
                            android:theme="@style/RatingBarGoldTheme" />

                        <TextView
                            android:id="@+id/textViewRatingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_color_e4a719"
                            android:fontFamily="@font/raleway_regular"
                            android:textSize="@dimen/text_size_14sp"
                            tools:text="83 oy" />
                    </LinearLayout>

                </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/errorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/padding_32dp">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/ic_error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/product_detail_not_found"
                android:textSize="@dimen/text_size_18sp"
                android:textColor="@color/text_color_ff3333"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/margin_top_15dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            style="?android:attr/progressBarStyleLarge" />

    </FrameLayout>
</layout>
